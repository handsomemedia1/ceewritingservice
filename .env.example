# Update these with your Supabase details from your project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_. Required for scholarship leads and the bots.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required by /api/cron/bot. Vercel Cron sends it automatically once set.
CRON_SECRET=generate-a-long-random-string

# Required by /api/telegram-webhook. Letters, digits, _ and - only.
# Run src/services/telegram/register_webhook.mjs after changing it.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string
